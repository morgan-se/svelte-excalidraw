{
  "name": "svelte-excalidraw-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:apps",
    "build:lib": "npm run build -w svelte-excalidraw",
    "build:apps": "npm run build -w demo -w starter -w svelte-excalidraw-docs",
    "dev:demo": "npm run dev -w demo",
    "dev:docs": "npm run dev -w svelte-excalidraw-docs",
    "dev:starter": "npm run dev -w starter"
  }
}
