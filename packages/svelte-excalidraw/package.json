{
  "name": "svelte-excalidraw",
  "version": "0.4.0",
  "description": "Svelte wrapper for Excalidraw with multiplayer",
  "scripts": {
    "build": "svelte-kit sync && svelte-package",
    "dev": "svelte-kit sync && svelte-package --watch",
    "prepublishOnly": "npm run build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "clean": "npx -y rimraf build dist .svelte-kit node_modules"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./export": {
      "types": "./dist/export-svg.d.ts",
      "default": "./dist/export-svg.js"
    },
    "./server": {
      "types": "./dist/server/excalidraw-room-stream.d.ts",
      "default": "./dist/server/excalidraw-room-stream.js"
    },
    "./remote": {
      "types": "./dist/excalidraw-room.remote.d.ts",
      "default": "./dist/excalidraw-room.remote.js"
    },
    "./server/file-storage": {
      "types": "./dist/server/excalidraw-room-file-storage.d.ts",
      "default": "./dist/server/excalidraw-room-file-storage.js"
    },
    "./server/state": {
      "types": "./dist/server/excalidraw-room-state.d.ts",
      "default": "./dist/server/excalidraw-room-state.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "author": "TippingService SL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tips-services/svelte-excalidraw.git"
  },
  "bugs": {
    "url": "https://github.com/tips-services/svelte-excalidraw/issues"
  },
  "homepage": "https://www.npmjs.com/package/svelte-excalidraw",
  "overrides": {
    "cookie": ">=0.7.0",
    "nanoid": "3.3.8",
    "lodash-es": ">=4.17.23"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@sveltejs/kit": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.2",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "publint": "^0.3.17",
    "svelte": "^5.50.2",
    "svelte-check": "^4.3.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {
    "valibot": "^1.2.0",
    "@excalidraw/excalidraw": "0.18.0-3a5ef40",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sveltekit-sse": "^0.14.3"
  }
}
